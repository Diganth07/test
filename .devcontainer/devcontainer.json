{
  "name": "LinkSnip Django Workbench",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && .venv/bin/python manage.py migrate && .venv/bin/python manage.py seed",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django"
      ],
      "settings": {
        "github.copilot.enable": {
          "*": false
        },
        "github.copilot.nextEditSuggestions.enabled": false,
        "editor.inlineSuggest.enabled": false,
        "chat.agent.enabled": false,
        "github.copilot.chat.codeGeneration.useInstructionFiles": true,
        "chat.useAgentsMdFile": true,
        "chat.useClaudeMdFile": false,
        "files.exclude": {
          ".github/copilot-instructions.md": true,
          "AGENTS.md": true,
          "CLAUDE.md": true,
          ".claude": true,
          ".cursorignore": true,
          ".codeiumignore": true,
          ".vscode": true,
          ".devcontainer": true
        },
        "search.exclude": {
          "**/.venv": true,
          "**/__pycache__": true,
          "**/db.sqlite3": true
        }
      }
    }
  }
}
